# 複製為 .env 後請改為強密碼（≥12 字元），勿提交 Git
#
# Portal bootstrap（僅在 portal_auth.db 尚無使用者時需要）：
#   - 首次啟動可用下列帳密登入；成功後會寫入 store/portal_auth.db
#   - 首次以 .env 密碼登入後，系統會強制導向「變更密碼」頁，必須立即設定新密碼才能使用 Portal
#   - 變更完成後請以 DB 新密碼登入；僅改 .env 不會更新已寫入 DB 的密碼
#   - DB 已有使用者時，下列帳密僅作 break-glass（帳號不在 DB 時）或空庫 bootstrap；日常請用「使用者管理」
#
# REST API（/api/v1）：請以 admin 登入 Portal「API Token」建立 token，見該頁使用手冊；勿在此設定 API 金鑰。
NCCM_ADMIN_USER=nccm_admin
NCCM_ADMIN_PASS=REPLACE_WITH_12CHAR_MIN

# Docker Compose 會覆寫下列兩項；本機直跑 uvicorn 時請自行設定
# NCCM_NETDRIVER_URL=http://127.0.0.1:8000
# NCCM_STORE_DIR=store

# Portal ↔ Agent 服務間 HMAC（必填；Compose 與本機 pytest 均需設定）
# 產生：python -c "import secrets; print(secrets.token_hex(32))"
NCCM_AGENT_HMAC_SECRET=REPLACE_WITH_RANDOM_64_HEX

# 可選：允許的 SSH port（預設 22,2222）
# NCCM_ALLOWED_SSH_PORTS=22,2222

# 可選：Session 簽章（必填於 production；多實例部署時請固定同一值）
NCCM_SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX

# 可選：production 模式（關閉 /docs、強制 Secure cookie 需搭配 NCCM_HTTPS=1）
# NCCM_ENV=production
# NCCM_HTTPS=1

# 本機開發若未設定 NCCM_SESSION_SECRET，可暫用（勿用於 production）：
# NCCM_ALLOW_EPHEMERAL_SESSION=1

# 可選：對外埠（預設 8501 / 8000）
# NCCM_PORT=8501
# NETDRIVER_AGENT_PORT=8000

# 排程 live 模式 SSH 憑證加密主金鑰（可選；未設時首次建立 live 排程會自動寫入 store/.secrets/fernet.key）
# 產生（僅 enterprise 覆寫用）：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NCCM_SECRETS_KEY=
# NCCM_SECRETS_KEY_FILE=/run/secrets/nccm_secrets_key